# Copy this file to .env for local development.
# Vite reads these values when the dev server starts and when you build.
# Restart `npm run dev` after changing them.

# Practice on this computer without Google.
# Entries stay in this browser. They are not written to a spreadsheet.
VITE_USE_MOCK=true

# Deployed web app URL. It must start with https://script.google.com/macros/s/
# and end with /exec. Leave blank while VITE_USE_MOCK=true.
VITE_APPS_SCRIPT_URL=

# Same value as the API_TOKEN script property.
# This value is embedded in the website bundle. It is not a private password.
# Leave blank while VITE_USE_MOCK=true.
VITE_API_TOKEN=

# Address encoded in the dashboard QR code and shown as the website link.
# Restart the dev server after changing this.
VITE_PUBLIC_URL=https://mohit-kumar101.github.io/Inventory/
